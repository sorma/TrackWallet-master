<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium">


    <GridLayout
        android:id="@+id/gridIcons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:orientation="horizontal">

        <!-- Esempi di icone -->
        <ImageView
            android:id="@+id/icona1"
            android:layout_width="@dimen/layout_50"
            android:layout_height="@dimen/layout_50"
            android:layout_margin="@dimen/layout_small"
            android:src="@drawable/user"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/icona_1"/>

        <ImageView
            android:id="@+id/icona2"
            android:layout_width="@dimen/layout_50"
            android:layout_height="@dimen/layout_50"
            android:layout_margin="@dimen/layout_small"
            android:src="@drawable/lucchetto"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/icona_2"/>

        <!-- Mostra più -->
        <ImageView
            android:id="@+id/iconaMostraPiu"
            android:layout_width="@dimen/layout_50"
            android:layout_height="@dimen/layout_50"
            android:layout_margin="@dimen/layout_small"
            android:src="@drawable/lucchetto"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/mostra_altre_icone"/>
    </GridLayout>

</LinearLayout>
