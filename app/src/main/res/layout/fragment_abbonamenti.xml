<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.fragment.impostazioni.abbonamentiFragment"
    android:orientation="vertical">

    <!-- MaterialToolbar per TopAppBar con Freccia, Titolo e Bottone aggiungi -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="@dimen/padding_small"
        app:title=""
        app:navigationIcon="@drawable/indietro">

        <!-- Titolo -->
        <TextView
            android:id="@+id/titolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/abbonamenti"
            android:layout_gravity="start|center_vertical"
            android:layout_marginEnd="@dimen/margin_small"
            android:textStyle="bold"
            android:textSize="@dimen/text_20"/>

        <!-- Bottone aggiungi -->
        <Button
            android:id="@+id/buttonAggiungi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aggiungi1"
            android:layout_marginEnd="@dimen/margin_medium"
            android:layout_gravity="end"/>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Divider -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <!-- RecyclerView per gli Abbonamenti -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAbbonamenti"
        android:layout_width="match_parent"
        android:layout_height="@dimen/layout_0"
        android:layout_weight="1"
        android:padding="@dimen/padding_small" />

</LinearLayout>