<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_conto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Icona a sinistra -->
        <ImageView
            android:id="@+id/iconaContoImageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:src="@drawable/busta" />

        <!-- Nome conto al centro -->
        <TextView
            android:id="@+id/nomeContoTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/nome_conto1"
            android:textSize="@dimen/text_header"
            />

        <!-- Saldo a destra -->
        <TextView
            android:id="@+id/saldoContoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0_00"
            android:textSize="@dimen/text_small_header"
            android:textStyle="bold"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
