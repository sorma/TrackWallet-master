<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium">

    <GridLayout
        android:id="@+id/gridColori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:orientation="horizontal">

        <!-- Esempi di colori -->
        <FrameLayout
            android:id="@+id/color1"
            android:layout_width="@dimen/layout_50"
            android:layout_height="@dimen/layout_50"
            android:layout_margin="@dimen/layout_small"
            android:background="@drawable/circle_color" />

        <FrameLayout
            android:id="@+id/color2"
            android:layout_width="@dimen/layout_50"
            android:layout_height="@dimen/layout_50"
            android:layout_margin="@dimen/layout_small"
            android:background="@drawable/circle_color" />

        <!-- Mostra più -->
        <FrameLayout
            android:id="@+id/colorMostraPiu"
            android:layout_width="@dimen/layout_50"
            android:layout_height="@dimen/layout_50"
            android:layout_margin="@dimen/layout_small"
            android:background="@drawable/circle_color"
            android:contentDescription="@string/mostra_altri_colori" />
    </GridLayout>

</LinearLayout>
