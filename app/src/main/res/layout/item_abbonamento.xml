<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAbbonamentoView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    app:cardCornerRadius="@dimen/corner_radius"
    app:cardElevation="@dimen/card_elevation"
    android:layout_marginHorizontal="@dimen/layout_small"
    android:layout_marginVertical="@dimen/layout_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/padding_medium"
        android:paddingStart="@dimen/padding_medium"
        android:paddingEnd="@dimen/padding_medium"
        android:paddingBottom="@dimen/padding_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/layout_0"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nome dell Abbonamento -->
                <TextView
                    android:id="@+id/nomeAbbonamentoTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_header"
                    android:paddingEnd="@dimen/padding_large"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <!-- Data Inizio -->
                    <TextView
                        android:id="@+id/dataInizioTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/data"
                        android:textSize="@dimen/text_small"
                        android:paddingEnd="@dimen/padding_small"
                        />

                    <!-- Divider -->
                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="@dimen/layout_1"
                        android:layout_height="match_parent"
                        app:dividerThickness="@dimen/dividerThickness"
                        android:background="@color/md_theme_onSurfaceVariant"/>

                    <!-- Data Inizio -->
                    <TextView
                        android:id="@+id/dataFineTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/data"
                        android:textSize="@dimen/text_small"
                        android:paddingStart="@dimen/padding_small"
                        />
                </LinearLayout>


            </LinearLayout>

            <!-- Importo della Abbonamento -->
            <TextView
                android:id="@+id/importoAbbonamentoTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/importo"
                android:textSize="@dimen/text_medium"
                android:layout_marginBottom="@dimen/layout_small"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/layout_smaller">

            <!-- Conto della Transazione -->
            <TextView
                android:id="@+id/contoAbbonamentoTextView"
                android:layout_width="@dimen/layout_0"
                android:layout_height="wrap_content"
                android:text="@string/conto_transazione"
                android:textSize="@dimen/text_paragraph"
                android:layout_weight="1"
                android:gravity="end"
                android:paddingEnd="@dimen/padding_small"
                />

            <!-- Divider -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="@dimen/layout_1"
                android:layout_height="match_parent"
                app:dividerThickness="@dimen/dividerThickness"
                android:background="@color/md_theme_onSurfaceVariant"/>

            <!-- Categoria della Transazione -->
            <TextView
                android:id="@+id/categoriaAbbonamentoTextView"
                android:layout_width="@dimen/layout_0"
                android:layout_height="wrap_content"
                android:text="@string/categoria_transazione"
                android:textSize="@dimen/text_paragraph"
                android:layout_weight="1"
                android:gravity="start"
                android:paddingStart="@dimen/padding_small"
                />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>