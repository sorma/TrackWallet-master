<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.jm.trackwallet.ui.welcome.fragment.LoginFragment"
        tools:layout="@layout/fragment_login"
        android:label="@string/loginfragment" >
        <action
            android:id="@+id/action_loginFragment_to_registratiFragment"
            app:destination="@id/registratiFragment" />
    </fragment>
    <fragment
        android:id="@+id/registratiFragment"
        android:name="com.jm.trackwallet.ui.welcome.fragment.RegistratiFragment"
        tools:layout="@layout/fragment_registrati"
        android:label="@string/registratifragment" >
        <action
            android:id="@+id/action_registratiFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>